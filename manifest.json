{
  "manifest_version": 3,
  "name": "Nirma Smart Attendance",
  "version": "1.0.1",
  "description": "Intelligent attendance calculator & scenario simulator for Nirma University Student Portal.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Nirma Smart Attendance",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://mis.nirmauni.ac.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mis.nirmauni.ac.in/*"
      ],
      "all_frames": true,
      "js": [
        "utils/calculations.js",
        "utils/storage.js",
        "content/attendance-detector.js",
        "content/attendance-calculator.js",
        "content/page-integration.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*",
        "content/styles.css",
        "dashboard/dashboard.html"
      ],
      "matches": [
        "https://mis.nirmauni.ac.in/*"
      ]
    }
  ]
}
